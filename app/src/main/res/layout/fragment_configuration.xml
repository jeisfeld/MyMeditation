<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="?attr/actionBarSize">

    <LinearLayout
        android:id="@+id/systemPromptSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_heading_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:labelFor="@id/editTextSystemPrompt"
                android:text="@string/label_system_prompt"
                android:textSize="@dimen/text_size_content_heading"
                android:textStyle="bold" />
            <Spinner
                style="@style/Widget.MyMeditation.CompactSpinner"
                android:id="@+id/spinnerSystemPromptTemplate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:saveEnabled="false"
                android:contentDescription="@string/system_prompt_templates" />
            <ImageButton
                android:id="@+id/buttonSystemPromptTemplates"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit_meditation"
                app:tint="?attr/colorControlNormal"
                android:contentDescription="@string/system_prompt_templates"
                android:tooltipText="@string/system_prompt_templates" />
        </LinearLayout>

        <EditText
            android:id="@+id/editTextSystemPrompt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/editText_horizontal_margin"
            android:layout_marginEnd="@dimen/editText_horizontal_margin"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:gravity="top"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:textSize="@dimen/text_size_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/queryTemplateSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_heading_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:labelFor="@id/editTextQueryTemplate"
                android:text="@string/label_query_template"
                android:textSize="@dimen/text_size_content_heading"
                android:textStyle="bold" />
            <Spinner
                style="@style/Widget.MyMeditation.CompactSpinner"
                android:id="@+id/spinnerQueryPromptTemplate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:saveEnabled="false"
                android:contentDescription="@string/query_prompt_templates" />
            <ImageButton
                android:id="@+id/buttonQueryPromptTemplates"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit_meditation"
                app:tint="?attr/colorControlNormal"
                android:contentDescription="@string/query_prompt_templates"
                android:tooltipText="@string/query_prompt_templates" />
        </LinearLayout>

        <EditText
            android:id="@+id/editTextQueryTemplate"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/editText_horizontal_margin"
            android:layout_marginEnd="@dimen/editText_horizontal_margin"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:gravity="top"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:textSize="@dimen/text_size_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/inlineAiSettingsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_heading_margin"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/ai_settings"
                    android:textSize="@dimen/text_size_content_heading"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:labelFor="@id/spinnerAiModelPreset"
                    android:text="@string/ai_model_presets_label" />
            </LinearLayout>
            <Button
                android:id="@+id/buttonAiSettings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/button_more"
                android:contentDescription="@string/ai_settings"
                android:textAllCaps="false" />
        </LinearLayout>

        <Spinner
                style="@style/Widget.MyMeditation.CompactSpinner"
            android:id="@+id/spinnerAiModelPreset"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:saveEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:labelFor="@id/spinnerSpeechModel"
            android:text="@string/speech_model_label" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <Spinner
                style="@style/Widget.MyMeditation.CompactSpinner"
                android:id="@+id/spinnerSpeechBackend"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/speech_output_label"
                android:saveEnabled="false" />
            <Spinner
                style="@style/Widget.MyMeditation.CompactSpinner"
                android:id="@+id/spinnerSpeechModel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:saveEnabled="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:labelFor="@id/spinnerSpeechVoice"
            android:text="@string/speech_voice_label" />
        <Spinner
                style="@style/Widget.MyMeditation.CompactSpinner"
            android:id="@+id/spinnerSpeechVoice"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:saveEnabled="false" />
    </LinearLayout>
</LinearLayout>

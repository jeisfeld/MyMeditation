<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/listViewManageDevices"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="48dp">

    <TextView
        android:id="@+id/textViewMeditationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/list_horizontal_margin"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?android:attr/textAppearanceMedium"
        app:layout_constraintEnd_toStartOf="@id/buttonPlayOffline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/buttonPlayOffline"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_playback_play"
        app:tint="?attr/colorControlNormal"
        android:contentDescription="@string/button_play_offline"
        android:tooltipText="@string/button_play_offline"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonShareOffline" />
    <ImageButton
        android:id="@+id/buttonShareOffline"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share_audio"
        app:tint="?attr/colorControlNormal"
        android:contentDescription="@string/button_share_offline"
        android:tooltipText="@string/button_share_offline"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonRenameMeditation" />

    <ImageButton
        android:id="@+id/buttonRenameMeditation"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_edit_meditation"
        app:tint="?attr/colorControlNormal"
        android:contentDescription="@string/rename_saved_meditation"
        android:tooltipText="@string/rename_saved_meditation"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageViewDelete" />

    <ImageButton
        android:id="@+id/imageViewDelete"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="?attr/colorControlNormal"
        android:src="@drawable/ic_button_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageViewDragHandle"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/imageViewDragHandle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_drag_handle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>